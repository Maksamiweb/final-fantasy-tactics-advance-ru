{
  "batch": "MAP-DESCRIPTION-FIT-01",
  "entries": [
    {
      "id": "fx_text/20/0",
      "ru": "Столица Ивалиса. В её\nцентре расположен\nдворец.[[40]][[42]]",
      "source_sha256": "46e6024c203dda1b50aa0496f21fc3b6d62ed4a6585a835bc214f04989758a37",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/1",
      "ru": "Оживлённый город.\nНа окраине\nнаходится банк\nмонстров.[[40]][[42]]",
      "source_sha256": "cdafe969828e641398cceb32376b4ae429d5070b6f5c5f7624eac03a56d095b6",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/2",
      "ru": "Горный город бангаа.\nЗдесь находится\nтюрьма.[[40]][[42]]",
      "source_sha256": "308d0b06b05baca4e89612bb48923d2b6355b0bf56e7e93c46b25860b16ec769",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/3",
      "ru": "Скрытый в лесной\nглуши город, где\nживут в основном\nвиеры.[[40]][[42]]",
      "source_sha256": "28b239d196fedb5c0d213969f9010b11c850b0f5bdea679478eda0f50e264e2f",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/4",
      "ru": "Город ну моу.\nСредоточие знаний и\nалхимии.[[40]][[42]]",
      "source_sha256": "3abfdac152b06a649373361639df101bb1a19de1fccf172c9bc8584cacdf7eed",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/5",
      "ru": "Город муглов с\nторговым портом\nвоздушных судов.[[40]][[42]]",
      "source_sha256": "40d95422b5f5e3abf38f5c9b1d7cf2df2a7b1c23851cd932db106a15abae5468",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/6",
      "ru": "Глухой тёмный лес.\nИзлюбленное\nубежище воров.[[40]][[42]]",
      "source_sha256": "7bcf4b226b1078456bd51529c49eeb1f49fab0b85de916d74b7261c2d1de83d1",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/7",
      "ru": "Травянистые холмы,\nгде растёт\nмускмалой.[[40]][[42]]",
      "source_sha256": "7cab71ab8483dcaa5532b7df1b399fdc33f42781c9824a7a858cd248a772debb",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/8",
      "ru": "Горные пики. Дом\nвымирающего вида\nтигров.[[40]][[42]]",
      "source_sha256": "306e9ffa9e1fbc4a40108d8b09b320c72afd35337ef034ad96d1efe664a4cf30",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/9",
      "ru": "Глубокие опасные\nболота со\nмножеством\nостровков.[[40]][[42]]",
      "source_sha256": "d696f9fe72b0b3e3d1c6bedc176f4ae473b176111fb12fa4cbe2551b6753e398",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/10",
      "ru": "Горячие пески\nкрупнейшей пустыни\nИвалиса.[[40]][[42]]",
      "source_sha256": "21990bd24cb91fce3a71cab12899e91c60db7483d5c0e4f9f606477f66a69534",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/11",
      "ru": "Оживлённый перевал.\nИногда встречаются\nпридорожные лавки.[[40]][[42]]",
      "source_sha256": "2f06d6011ba9db285c6ad9776376e7d720657fa4ea0e756e81ff52ec3e2563a2",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/12",
      "ru": "Свежий лесной\nвоздух насыщен\nчистой магией.[[40]][[42]]",
      "source_sha256": "e70094f90f00ecfca52d62a38343840f7229c235ae4da7abe718151d4459736d",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/13",
      "ru": "Крупнейшая река\nИвалиса. Петляет\nсреди болот.[[40]][[42]]",
      "source_sha256": "3f4255367e5fc278706e0ea65e49a02957dc2aeb1bd59a7cc93b02cc5261f2d2",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/14",
      "ru": "Равнины, где сражались\nтринадцать легендарных\nрыцарей.[[40]][[42]]",
      "source_sha256": "33876731175fc161686446bd501a60731584312b3f7008886ccbf9d4458127dc",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/15",
      "ru": "Вулкан, спавший\nтриста лет, недавно\nвновь пробудился.[[40]][[42]]",
      "source_sha256": "e82123eca018a5621af3c9163901bfba57ca051cb7bb96a870460269c7f41c9a",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/16",
      "ru": "Опасная пустыня,\nполная чудовищ и\nсокровищ.[[40]][[42]]",
      "source_sha256": "d9f7fe17e6a4edcd6f7b59188a1e54e0c7b1e440ec9511a0618a7ea769bf3eff",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/17",
      "ru": "Из этой пещеры веет\nпрохладой.[[4F]][[42]]Говорят, в её\nглубинах покоится\nдревний город.[[40]][[42]]",
      "source_sha256": "4ad51de0ba5b233d029cd509d99a5c3063cf11c6b7e67c828e92b5482012ec20",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/18",
      "ru": "Здесь всегда слышно\nптичье щебетание.[[4F]][[42]]Посреди леса стоит\nзаброшенная\nкрепость.[[40]][[42]]",
      "source_sha256": "d23ef3188fb3beca54bfaf6199eb23bf12972e0c8e799f0c13162159bb98c046",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/19",
      "ru": "Пустыня, известная\nсвоими лающими\nпесками.[[4F]][[42]]Говорят, это кости\nнебесного зверя,\nставшие песком.[[40]][[42]]",
      "source_sha256": "b18dd2b13e64d4f90f39f7eed972d10a0bcda541cd875601ac9080ba6f42d7ad",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/20",
      "ru": "Пустыня, славная\nмиражами и\nкрасными чокобо.[[40]][[42]]",
      "source_sha256": "7e73f06c10f77fbb1909ebefd65ba94e75b99a883219ccac3329fb53159aee25",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/21",
      "ru": "Пологие равнины.\nИногда здесь бывает\nнашествие\nнасекомых.[[40]][[42]]",
      "source_sha256": "1e0339278880c7ae24a70c3b6e56c30994363ba54b7bc6ffb2a2f8774be466fe",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/22",
      "ru": "Равнины жёлтого\nпеска и красной\nземли.[[4F]][[42]]Среди камней здесь\nчасто находят\nянтарь.[[40]][[42]]",
      "source_sha256": "476e9cf052817fed58cf50541d6ec3a13aede51fc1de48de5bd52500f65b07a8",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/23",
      "ru": "Глубокая долина.\nЗдесь добывают\nянтарь, как и на\nравнинах Дети.[[40]][[42]]",
      "source_sha256": "b76d8063838ef2e3241d2eb8e64cf6069da36ee1812c7a3eefa45560faf275cf",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/24",
      "ru": "Зелёный густой лес,\nизвестный залежами\nматерита.[[40]][[42]]",
      "source_sha256": "c2b6b600c20e6cdaeeabf42f9f6a139a2edeb6f9b237b780916987c8e7ada3b0",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/25",
      "ru": "Когда-то в этих\nпещерах добывали\nмифрил.[[40]][[42]]",
      "source_sha256": "8389ca5745d13ab1f42d3d38408dfd5b84ad1abcbd4d4303d5957e88aab12381",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/26",
      "ru": "Ягд, где не действуют\nзаконы. Покинутый\nгород.[[40]][[42]]",
      "source_sha256": "5153d3f6c416e2e2a9681a576e07f16c62c234f1137489d379f1c894ae86030a",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/27",
      "ru": "Ягд без законов.\nЗдесь слышатся\nпризрачные голоса.[[40]][[42]]",
      "source_sha256": "e742db346adf7f4f1598576934c4c4314f2211864ed44f23905efeef4a51dc1e",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/28",
      "ru": "Ягд без законов,\nразрушенный своей\nдикой магией.[[40]][[42]]",
      "source_sha256": "ddaad4b183bdb2962f3f6a0283a51006cf1ceced68b98ad0cf4be64a39ad335f",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/20/29",
      "ru": "Прекрасная долина.\nСкалы сияют\nянтарным светом.[[4F]][[42]]Здесь был летний\nдворец королей\nИвалиса.[[40]][[42]]",
      "source_sha256": "fae523ba637f1ef1432d563033d909bedfffa24f42341a477161cfaaefc79be4",
      "runtime_verified": false,
      "max_width": 144,
      "max_lines": 4,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/1",
      "ru": "Патрулируют дворец\nБервении, охраняют\nкоролеву. Упрямы и\nнеразговорчивы.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "e847913c5721b56a70ee20ae6806018da0a1fd59d9f4b627b4fd8c6ac8eae756",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/2",
      "ru": "Главная территория\n— Сирил. Грабят\nпутников, горожан не\nтрогают.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "723911b93211b8da3cd10383358078a838d1a2859f37f353a05fd18f3d765bc5",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/3",
      "ru": "Дезертиры городской\nстражи. Хотят\nподчинить себе все\nкланы.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "7483e082b6d48e1d46f61b179c3401e2078a88129e4402c4971f58d94a07196b",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/4",
      "ru": "Любят работать в\nпомещении. На улице быстро\nсердятся. Лучше обходить\nстороной.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "14ea8f8f6a420bdf5344d52d38df3b05886dbb57a1e7d6d431626ea9bf03c305",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/5",
      "ru": "Выносливые жители пустыни.\nЧасто служат посыльными на\nпустынных маршрутах.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "9a6077b72c735f3c694dcf468c3204cb1c2c192c0d4f606c62dcfc78d434d9bc",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/6",
      "ru": "Разбойники на\nскоростном корабле\n«Ускоритель». Ловите\nих на земле.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "97eeb7bb41e6b92e31fcd8cb1843eef2c9b8f4793047b2283cd3df241ddf62f0",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/7",
      "ru": "Ярые защитники\nприроды. Не терпят\nчужаков в своём лесу.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "f72114360712b17ef7cbfb4d75699333c3bd4a901f0a88f6af4b55dfa5a5b5e5",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/8",
      "ru": "«Сначала бой, потом\nвопросы!» Любят\nчестные поединки.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "e8c1b0512524939612f9dea19e3c8eae82d622365b45b0da87e8ee964a029da2",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/9",
      "ru": "Дикий монстр с\nпиков Кудик. Иногда\nспускается нападать\nна людей.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "0d4b7599e9f4623cd90dd5077f786a9f5ff35357fcbecf1a696ef06f27fa207d",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/10",
      "ru": "Местные боятся их\nкак водяных духов.\nНападают на тех, кто\nподходит к озеру.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "6f29861dd68ddb17b17af8307e2a13436bdf76094dcf392f9baaaafa1215df7b",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/11",
      "ru": "Обманом заставляют\nврага победить\nсамого себя. Не\nподходите к их базе![[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "67862b733281a908ea1e7a1f1e049e5aa4e6f7936d16b4b8e7001dedded62fd6",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/12",
      "ru": "Искусные лучники.\nБерегитесь ударов в\nспину.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "fcf645238cf1abc7f2993f1728aefcea57414f2ac3f76b69470474426cf68319",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/13",
      "ru": "Горные разбойники с\nбазой в лесу Коринг.\nЖивут охотой и\nсобирательством.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "d639ae83a1a6cdd9e5c4dad0f86356bb32f30f0aaae311f9ec4c7676b9d287b2",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/14",
      "ru": "Их база на мелководье.\nИзбегайте боёв на воде:\nатакуйте с суши![[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "d6fe96f327b8de81a97ccb04cdd6ecff41bae986daeb041787b60f0b2b28ccfc",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/15",
      "ru": "Призрак солдата,\nпогибшего на\nпрошлой войне. Всё\nещё ищет врага...[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "b0d6b592f9efb5ef7310df860d9461b0531af4b061def2ad03b05e77598edc22",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/16",
      "ru": "Огненный змей спит в\nвулкане Рода. Порой\nвыходит из жерла на\nохоту.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "bc160c5bc07c95d74839b85debe951f0cb1f0df615cc6ececc2fe08456a92a47",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/17",
      "ru": "Грозные муравьиные\nльвы. Часто покидают\nпесчаные гнёзда в\nпоисках пищи.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "8b65d1c4f6bd5893ce97aaa193b1294f30a87f438e70f6f1c018529da70d0308",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/18",
      "ru": "Пещерный монстр.\nБерегитесь зубов,\nспособных нанести\nнесколько ударов.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "8e05cf59dc14029f6dcea15e6fe12fd5879ea347d9297233d8a57822815e1a82",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/19",
      "ru": "Лесная фея. Любит\nпроказы и порой\nдоводит людей до\nбезумия.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "55df31bb638e3adc3c327d559b7cc68be8e5a12bd5829c44175e6ef503c2cdf8",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/20",
      "ru": "Гордые драгуны. Любят\nвызывать достойных врагов.\n«Сражайтесь с честью!»[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "4a1419ab6ad80962d8856b9d5504918fe587b633c71c22d2a97b23c32d416831",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/21",
      "ru": "Пустынный монстр.\nОбычно безобиден,\nпока не\nпроголодается.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "730e12ad617639d3519eec4bf825966dcc88f509000cd8023be8b05014ccab0e",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/22",
      "ru": "Тёмная шайка, некогда\nдержавшая пол-Ивалиса.\nВраждует с бандой Бардо.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "e07ccfdec86b013a7617303a194a86557dabafd525735227c0e258c3de334a43",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/23",
      "ru": "Горные разбойники.\nПрославились побегом,\nосвободив вожака Берка из\nтюрьмы.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "78ce4b3482f09931ae6a4e22b2de102506c1efbe040e5d5c2cfad08092b88ce2",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/24",
      "ru": "Фанатики Зоары.\nХотят уничтожить\nмир и вернуть «Время\nначала».[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "07e26302e7fd547a1f199d10a30f7654209807e22b093891f510c9ff488d3899",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/25",
      "ru": "Обычно встречаются\nв лесах. Злобные\nмонстры. Будьте\nосторожны.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "cb159def99cf4b8f18c62acf58b93dfa5e79af82432efd05bab91ef5d081efe0",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/26",
      "ru": "Сидят в пещере и\nсчитают гил.\nНападают на любого\nпутника с деньгами.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "04043e229b64cc52c469e590be5f4a7d5e6d596d81ddaf2a036b6632ae208798",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/27",
      "ru": "Лишь в ягдах\nвстретишь клан, где\nлюди вместе с\nмонстрами. Опасны.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "072cc206dade4f6bee47e987ef23ef9bbd76aeaddc5b8035f6fdbb7ffcc20197",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/28",
      "ru": "Приходят из ягдов,\nнесут злобу и хаос.\nНенавидят любые\nзаконы.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "ea828565e1cfd8480577b0fe53226540380f8092fc94808ec81f8b772cbfc28d",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/29",
      "ru": "Тёмные существа из\nбеззаконных ягдов.\nУтягивают живых во\nтьму.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "ea83acfe801091fee75bb82c72743eef4bb7d62d7ea4165ac84a537cf3f76c8c",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/6/30",
      "ru": "Ответвление нового\nклана «[[5107]]».\nБыстро набирает\nсилу.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "dd85a1c5f261a8e9406821b83475064a36cb93fd4dbc0984500578f8786d2ca4",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/7/0",
      "ru": "Арсенал Рамсена. Только\nначали? Вам сюда!\nНедорогое снаряжение для\nлюдей.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "eb8428da893038a201e0df243d69097e6ad34a8f9dfeeb329fe4a161272bd230",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/7/1",
      "ru": "Товары бангаа. Лавка\nв Спроме с ворчливым\nхозяином. Дёшево\nдля бангаа.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "205cc8956dddcc750364ca28627f38ad6cd787af78de0bc01e25e1f6a8aad8ed",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/7/2",
      "ru": "Лавка Элен. Ею\nзаведует виера Элен.\nПорой отличные мечи\nстоят недорого.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "694a4c5c7e54a0a916933627bb1c934289b617135af111134ac725f0b96e7408",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/7/3",
      "ru": "Арсенал «Оазис» у академии\nКадоана. Оружие и прочее.\nДешёвые посохи и жезлы.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "e87ef4ed343938979a9135019110b4d176345981e712c00a52392fbeca0f3244",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/7/4",
      "ru": "Арсенал Складского\nпереулка. Братья-муглы\nпродают оружие прямо со\nскладов Багубы.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "82deb64001d352b9a96346fb5bc1226e1165965ccde75f213ae871f665a74d6e",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/7/5",
      "ru": "«Гарцующий чокобо».\nЛюбимый трактир кланов.\nЗдесь горожане оставляют\nзаявки.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "31986ee2502524b7fb7567961e76a591360a129eb8d6b5c0022a291244cb2396",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/7/6",
      "ru": "«Длинное ухо». В\nэтом гнезде драк и\nслухов не бывает\nтихих ночей.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "418b0d6231f731add3c64e4f3fa73c9d71cd1431be8886de142904247f0f5dde",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/7/7",
      "ru": "Гостиница Спина.\nНебольшая, на главной\nулице. Вечером слушают\nтрихорд.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "919e43048e6d66c622a6d247dc28974a72ac2598e27d58566bc227dae89099fb",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/7/8",
      "ru": "«Спящая лягушка».\nЕдинственный трактир\nКадоана. Послушайте\nкваканье у оазиса![[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "de39c30a9d29e47c21b0e0b7c93883149218de65db66f0e6d8d9a20f6d4fce38",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/7/9",
      "ru": "«Золотой гил». Вывеска в\nформе древней монеты.\nЗдесь бывают экипажи\nкораблей.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "7bb69b590efba4e5373fbf3fcaf21bde47202f40a5ddfa21a6a636f890de1117",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/7/10",
      "ru": "Самое строгое место\nИвалиса. Заведует стража\nкоролевы. Лучше сюда не\nпопадать.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "98bd7a478120b367bae2c31dda7c03360ac7b2ed2ce666ce541709b14c780936",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/7/11",
      "ru": "Лавка карт. Хозяин —\nсамозваный гений [[510A]].\n«Победа над законом — всего\nв одном обмене!»[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "ca036476993132decf06174684f2c02eab0b36735327487a08d3e9b18f9ee5ef",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "compact_ui",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    },
    {
      "id": "fx_text/7/12",
      "ru": "Единственный банк\nмонстров Ивалиса.\nБесплатный, всегда\nбезупречно чистый.[[40]][[42]]",
      "max_width": 144,
      "max_lines": 4,
      "source_sha256": "1996f69d66310fac5fee447ec341ba30843cc0b7f037f4305628dae01633216d",
      "runtime_verified": false,
      "layout_profile": "large_help_unverified",
      "font_profile": "normal",
      "resolve_fixed_references": true,
      "measure_control_offsets": true
    }
  ]
}
