{
  "batch": "P05-B020",
  "entries": [
    {
      "id": "fx_text/4/0",
      "ru": "Добро пожаловать! Чем могу помочь?[[56]][[42]]"
    },
    {
      "id": "fx_text/4/1",
      "ru": "У вас не хватает гилей.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/2",
      "ru": "Больше вы не унесёте, сударь.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/3",
      "ru": "С вас [[404]] гилей.\n[[3210]]Да/[[EOS]]Отмена[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/4",
      "ru": "Вам, похоже, нечего продавать.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/5",
      "ru": "Нельзя продать надетое снаряжение.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/6",
      "ru": "Спасибо за покупку![[56]][[42]]"
    },
    {
      "id": "fx_text/4/7",
      "ru": "Пока нет торговых товаров. Простите.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/8",
      "ru": "Заходите ещё![[5328]][[42]]"
    },
    {
      "id": "fx_text/4/9",
      "ru": "Добро пожаловать! У нас новые товары.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/10",
      "ru": "Клан [[403]]! Для вас особые цены![[56]][[42]]"
    },
    {
      "id": "fx_text/4/11",
      "ru": "Понятно. Жаль.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/12",
      "ru": "О, покупатель. Чего желаешшь?[[56]][[42]]"
    },
    {
      "id": "fx_text/4/13",
      "ru": "Не хватает гилей![[40]][[42]]"
    },
    {
      "id": "fx_text/4/14",
      "ru": "Большше не унесёшь, сынок![[40]][[42]]"
    },
    {
      "id": "fx_text/4/15",
      "ru": "С тебя [[404]] гилей.\n[[3210]]Да/[[EOS]]Отмена[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/16",
      "ru": "У тебя, похоже, нечего продавать...[[56]][[42]]"
    },
    {
      "id": "fx_text/4/17",
      "ru": "Надетые вещщи не продают, сынок.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/18",
      "ru": "Сспасибо![[56]][[42]]"
    },
    {
      "id": "fx_text/4/19",
      "ru": "На сегодня всё. Заходи позже.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/20",
      "ru": "Приходи ещщё![[5328]][[42]]"
    },
    {
      "id": "fx_text/4/21",
      "ru": "Приветсствую! Есть новые вещщи.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/22",
      "ru": "Клан [[403]]! Для вас сскидки![[56]][[42]]"
    },
    {
      "id": "fx_text/4/23",
      "ru": "Яссно.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/24",
      "ru": "Добро пожаловать в нашу лавку.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/25",
      "ru": "Тысяча извинений, но гилей не хватает.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/26",
      "ru": "Больше этих вещей вы не унесёте.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/27",
      "ru": "С вас [[404]] гилей.\n[[3210]]Да/[[EOS]]Отмена[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/28",
      "ru": "Вам, кажется, нечего продавать.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/29",
      "ru": "Надетое снаряжение продать нельзя, друг.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/30",
      "ru": "Благодарю вас.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/31",
      "ru": "Очень жаль, но торговые товары на сегодня кончились.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/32",
      "ru": "Спасибо за покупку. Прошу, заходите ещё.[[5328]][[42]]"
    },
    {
      "id": "fx_text/4/33",
      "ru": "Добро пожаловать. У нас есть новые товары.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/34",
      "ru": "А, клан [[403]].[[4F]][[42]]Для нас честь снизить для вас цены.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/35",
      "ru": "Хорошо.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/36",
      "ru": "Добро пожаловать![[56]][[42]]"
    },
    {
      "id": "fx_text/4/37",
      "ru": "Ой, простите, но у вас не хватает гилей![[40]][[42]]"
    },
    {
      "id": "fx_text/4/38",
      "ru": "Больше этих вещей вы не унесёте.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/39",
      "ru": "Получается [[404]]. Хорошо?\n[[3210]]Да/[[EOS]]Отмена[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/40",
      "ru": "Простите, я не могу купить то, чего у вас нет![[56]][[42]]"
    },
    {
      "id": "fx_text/4/41",
      "ru": "Сначала снимите снаряжение, а потом продавайте.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/42",
      "ru": "Спасибо![[56]][[42]]"
    },
    {
      "id": "fx_text/4/43",
      "ru": "Простите, сейчас всё кончилось. Приходите позже![[56]][[42]]"
    },
    {
      "id": "fx_text/4/44",
      "ru": "Спасибо, что заглянули! Заходите ещё![[5328]][[42]]"
    },
    {
      "id": "fx_text/4/45",
      "ru": "Вы как раз вовремя! Взгляните на новинки.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/46",
      "ru": "О, клан[[1D01]][[403]]? Вот честь! Снижу для вас цены![[56]][[42]]"
    },
    {
      "id": "fx_text/4/47",
      "ru": "Понятно. Ну что ж.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/48",
      "ru": "[[103]]Добро пожаловать, купо![[56]][[42]]"
    },
    {
      "id": "fx_text/4/49",
      "ru": "[[103]]М-м... Гилей мало, купо! Не продам![[40]][[42]]"
    },
    {
      "id": "fx_text/4/50",
      "ru": "[[103]]Больше не унесёте, купо! Слишком тяжело![[40]][[42]]"
    },
    {
      "id": "fx_text/4/51",
      "ru": "[[102]]С вас [[404]] гилей, купо!\n[[3210]]Да/[[EOS]]Отмена[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/52",
      "ru": "[[104]]Но вам нечего продавать, купо![[56]][[42]]"
    },
    {
      "id": "fx_text/4/53",
      "ru": "[[104]]Для продажи снимите эти вещи, купо![[40]][[42]]"
    },
    {
      "id": "fx_text/4/54",
      "ru": "[[101]]Спасибо, купо![[56]][[42]]"
    },
    {
      "id": "fx_text/4/55",
      "ru": "[[104]]Прости, всё кончилось, купо. Приходи ещё...[[56]][[42]]"
    },
    {
      "id": "fx_text/4/56",
      "ru": "[[103]]Приходи ещё, купо![[5328]][[42]]"
    },
    {
      "id": "fx_text/4/57",
      "ru": "[[103]]Добро пожаловать! У нас новинки, купо![[56]][[42]]"
    },
    {
      "id": "fx_text/4/58",
      "ru": "[[101]]Клан [[403]]! Добро пожаловать! Будет купо-скидка![[56]][[42]]"
    },
    {
      "id": "fx_text/4/59",
      "ru": "[[104]]Купопо... Вот жаль.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/60",
      "ru": "[[103]]Завезли торговые товары, купо! Взгляни, купо![[56]][[42]]"
    },
    {
      "id": "fx_text/4/61",
      "ru": "[[101]]Есть новые торговые товары, [[400]]! Купо![[4F]][[42]][[103]]Трудно торговать, купо. За вещами летаю в другие земли.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/62",
      "ru": "Приветствую![[56]][[42]]"
    },
    {
      "id": "fx_text/4/63",
      "ru": "Присаживайся, отдохни.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/64",
      "ru": "Последние слухи слышал?[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/65",
      "ru": "Давно не было хороших слухов.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/66",
      "ru": "Пока заданий на доске нет. Прости.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/67",
      "ru": "Какое задание возьмёшь?[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/68",
      "ru": "Вот задания, за которые вы взялись.[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/69",
      "ru": "Прости, у вас нет заданий.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/70",
      "ru": "Погоди, некого отправить на задание![[40]][[42]]"
    },
    {
      "id": "fx_text/4/71",
      "ru": "Для задания нужно [[41B]]. Приходи позже.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/72",
      "ru": "Для задания нужно: [[415]].[[4F]][[42]]Лучше приди позже.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/73",
      "ru": "Для задания нужны:[[4F]][[42]][[416]]\n[[417]][[4F]][[42]]Не хватает: [[415]]. Принеси оба предмета.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/74",
      "ru": "Для задания нужен уровень [[41A]] в навыке «[[418]]».[[40]][[42]]"
    },
    {
      "id": "fx_text/4/75",
      "ru": "Тут сказано: «Нужна профессия: [[419]]». Прости.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/76",
      "ru": "Это задание на отправку.[[4F]][[42]]Выбери одного бойца клана, которого пошлёшь.[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/77",
      "ru": "Что возьмёшь на задание [[4600]][[[41C]]]?[[56]][[42]]"
    },
    {
      "id": "fx_text/4/78",
      "ru": "С тебя [[41B]] за сведения.[[56]]\nСпасибо.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/79",
      "ru": "Я записал вас на задание. Удачи![[56]][[42]]"
    },
    {
      "id": "fx_text/4/80",
      "ru": "Похоже, брать с собой нечего: нет предметов заданий.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/81",
      "ru": "Я отменил это задание.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/82",
      "ru": "Приходи ещё![[5360]][[42]]"
    },
    {
      "id": "fx_text/4/83",
      "ru": "Удачи на задании![[5360]][[42]]"
    },
    {
      "id": "fx_text/4/84",
      "ru": "С предметами заданий всё готово.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/85",
      "ru": "Просто присматриваешься?[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/86",
      "ru": "Прежде чем браться, убедись, что задание подходит.[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/87",
      "ru": "Для задания нужны:[[4F]][[42]][[416]]\n[[417]][[4F]][[42]]Похоже, нет ни того ни другого! Принеси в другой раз.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/88",
      "ru": "Так, [[400]]. Есть предметы заданий?[[4F]][[42]]Они нужны для некоторых заданий.[[4F]][[42]]Их получают за выполнение заданий.[[4F]][[42]]Пока у тебя их нет. Просто нажми «ОК».[[56]][[42]]"
    },
    {
      "id": "fx_text/4/89",
      "ru": "Здесь предметы не нужны. Просто нажми «ОК».[[56]][[42]]"
    },
    {
      "id": "fx_text/4/90",
      "ru": "В тюрьме правит закон, вершится суд. Добро пожаловать![[56]][[42]]"
    },
    {
      "id": "fx_text/4/91",
      "ru": "Хм. Твоих знакомых здесь вроде бы нет.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/92",
      "ru": "Кого желаешь увидеть?[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/93",
      "ru": "Освободить нельзя: он сидит ради помилования.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/94",
      "ru": "Залог — [[410]] гилей.[[4F]][[42]]Точно заплатишь?\n\n[[3210]]Да/[[EOS]]Нет[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/95",
      "ru": "Не выйдет. Гилей не хватает. Ступай домой.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/96",
      "ru": "Бумаги подписаны. Заключённый свободен.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/97",
      "ru": "Никому не нужно помилование. Так держать.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/98",
      "ru": "Кому нужно помилование?[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/99",
      "ru": "Прости, для помилования мало гилей.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/100",
      "ru": "Готов отправить этого бойца в тюрьму[[4F]][[42]]ради помилования?\n\n[[3210]]Да/[[EOS]]Нет[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/101",
      "ru": "Тогда он побудет у нас. Не нарушай закон.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/102",
      "ru": "Прощай. Пусть свет праведности укажет путь.[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/103",
      "ru": "Передумал? Хорошо.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/104",
      "ru": "Пока глава клана сидит за помилование, клан не работает.[[4F]][[42]]Точно пойдёшь в тюрьму, [[400]]?\n[[3210]]Да/[[EOS]]Нет[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/105",
      "ru": "Заходи, [[400]]. Сиди и раскаивайся.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/106",
      "ru": "Помилование получено. Можешь идти.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/107",
      "ru": "А, [[400]]. Одному из твоих бойцов пора на волю.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/108",
      "ru": "А, [[400]]. Похоже, нужна моя помощь![[56]][[42]]"
    },
    {
      "id": "fx_text/4/109",
      "ru": "Законы — тоска. Собирай побольше карт![[56]][[42]]"
    },
    {
      "id": "fx_text/4/110",
      "ru": "Вот все мои карты. Что-нибудь нужно?[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/111",
      "ru": "Прости, карты кончились. Ещё будут, обещаю.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/112",
      "ru": "Прости, [[400]], но для обмена нужны карты.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/113",
      "ru": "Думаю, обмен честный.[[4F]][[42]]Согласен?\n\n[[3210]]Да/[[EOS]]Нет[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/114",
      "ru": "Отлично! Пусть карты принесут пользу.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/115",
      "ru": "Приходи за помощью в любое время, [[400]].[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/116",
      "ru": "Не меняемся? Ладно, без проблем.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/117",
      "ru": "Бойцов мало — боевые карты дешевеют![[4F]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/118",
      "ru": "Судья по магии в отпуске. Магические карты дёшевы![[4F]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/119",
      "ru": "В День мимов — скидки на карты повтора![[4F]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/120",
      "ru": "Законы комбо меняют, карты комбо дешевеют![[4F]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/121",
      "ru": "Карты лечения дёшевы. Белые маги, налетайте![[4F]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/122",
      "ru": "Коллекционер распродал запас. Карты оружия дёшевы![[4F]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/123",
      "ru": "Сезон мальборо кончается. Карты недугов дешевеют![[4F]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/124",
      "ru": "Дворец ратует за равенство рас. Карты урона расам дёшевы![[4F]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/125",
      "ru": "Я довёл свой метод до совершенства! Редкие карты дешевле![[4F]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/126",
      "ru": "Гильдия бойцов взвинтила цены на боевые карты. Прости.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/127",
      "ru": "В Академии Кадоана экзамены. Магические карты нарасхват.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/129",
      "ru": "«Соседи» взвинтили цены на карты области.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/130",
      "ru": "Судьи по-новому считают урон. Осторожнее![[56]][[42]]"
    },
    {
      "id": "fx_text/4/131",
      "ru": "Законы оружия строже — карты оружия дороже.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/132",
      "ru": "Карты недугов дороже: «замедлили» коня принца.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/133",
      "ru": "Кругом любовь и мир. Карты урона расам дорожают.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/134",
      "ru": "[[5117]] ужесточил меры! Редкие карты дорожают.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/135",
      "ru": "Слушай, [[400]], у меня к тебе просьба.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/136",
      "ru": "Конечно. Что такое?[[40]][[42]]"
    },
    {
      "id": "fx_text/4/137",
      "ru": "Мой друг организует сопротивление.[[4F]][[42]]Против законов и всего такого. Помоги ему.[[4F]][[42]]Я оставлю заказ в таверне.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/138",
      "ru": "Вчера я придумал невероятно мощный антизакон![[4F]][[42]]Соберёшь нужные материалы?[[40]][[42]]"
    },
    {
      "id": "fx_text/4/139",
      "ru": "Без проблем! Оставь заказ в таверне.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/140",
      "ru": "Так и сделаю. Спасибо, парень.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/141",
      "ru": "Заглянул, [[400]]! Давай меняться картами![[4F]][[42]]Выкладывай карты, пока сумма рангов не сравняется с ценой.[[4F]][[42]]Цены меняются каждый день. Заходи чаще! Вот мои карты.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/142",
      "ru": "Поделюсь тайными сведениями о рынке. Тс-с![[4F]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/143",
      "ru": "Добро пожаловать в зверинец. Чем помочь?[[56]][[42]]"
    },
    {
      "id": "fx_text/4/144",
      "ru": "Добро пожаловать в зверинец. Чудовище ждёт вас![[56]][[42]]"
    },
    {
      "id": "fx_text/4/145",
      "ru": "Чем могу помочь?[[56]][[42]]"
    },
    {
      "id": "fx_text/4/146",
      "ru": "Чтобы растить чудовище, сначала нужно его «Поймать»![[56]][[42]]"
    },
    {
      "id": "fx_text/4/147",
      "ru": "Вырастите хорошее послушное чудовище![[40]][[42]]"
    },
    {
      "id": "fx_text/4/148",
      "ru": "Сейчас там нет чудовища.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/149",
      "ru": "Уверены? Оно уже не вернётся!\n[[3211]]Да/[[EOS]]Нет[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/150",
      "ru": "Тогда отпускаю. Прощай![[56]][[42]]"
    },
    {
      "id": "fx_text/4/151",
      "ru": "Приходите в гости![[5360]][[42]]"
    },
    {
      "id": "fx_text/4/152",
      "ru": "Понятно. Пока оставлю его здесь.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/153",
      "ru": "Ах, беда. Корм кончился.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/154",
      "ru": "Подойдёт [[1D02]][[40E]][[1B01]]x[[1B01]][[40F]]?\n[[3210]]Да/[[EOS]]Нет[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/155",
      "ru": "Кажется, ему очень нравится![[56]][[42]]"
    },
    {
      "id": "fx_text/4/156",
      "ru": "Похоже, ему по вкусу![[56]][[42]]"
    },
    {
      "id": "fx_text/4/157",
      "ru": "Фу, выплюнуло обратно.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/158",
      "ru": "Ладно, пока без корма.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/159",
      "ru": "Гр-р-р... (Чего уставился?)[[56]][[42]]"
    },
    {
      "id": "fx_text/4/160",
      "ru": "(Дай еды.)[[56]][[42]]"
    },
    {
      "id": "fx_text/4/161",
      "ru": "(Спасибо, что зашёл.)[[56]][[42]]"
    },
    {
      "id": "fx_text/4/162",
      "ru": "(Люблю тебя, [[400]]. Правда, люблю!)[[56]][[42]]"
    },
    {
      "id": "fx_text/4/163",
      "ru": "[[400]]!! Помоги найти сбежавших чудовищ![[4F]][[42]]Я оставлю заказ в таверне![[40]][[42]]"
    },
    {
      "id": "fx_text/4/164",
      "ru": "Привет, [[400]]. Уже пробовал связь?[[4F]][[42]]Объединяйся и меняйся с кланами по связи![[4F]][[42]]Совместная игра делает кланы союзными.[[4F]][[42]]Найди как можно больше союзных кланов![[40]][[42]]"
    },
    {
      "id": "fx_text/4/165",
      "ru": "С возвращением, [[400]]. Хочешь сыграть по связи?[[40]][[42]]"
    },
    {
      "id": "fx_text/4/166",
      "ru": "Что будем делать?[[56]][[42]]"
    },
    {
      "id": "fx_text/4/167",
      "ru": "Погоди, поищу клан для совместного задания.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/168",
      "ru": "Новый клан! Клан [[433]] хочет присоединиться.[[4F]][[42]]Добавлю его в список. Теперь выбери задание.[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/169",
      "ru": "Клан [[433]] вам поможет. Выбери задание![[5360]][[42]]"
    },
    {
      "id": "fx_text/4/170",
      "ru": "Впервые помогаешь клану [[433]]![[4F]][[42]]Добавлю его в список. Жди задания...[[56]][[42]]"
    },
    {
      "id": "fx_text/4/171",
      "ru": "Ты помогаешь клану [[433]]. Жди задания...[[56]][[42]]"
    },
    {
      "id": "fx_text/4/172",
      "ru": "Не могу найти кланы для совместной игры.[[5360]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/173",
      "ru": "Нет подходящих заданий. Попробуй позже.[[5360]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/174",
      "ru": "Хочешь взяться за это задание?\n[[3210]]Да/[[EOS]]Нет[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/175",
      "ru": "Задание выбрано! Проверь его и нажми «ОК».[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/176",
      "ru": "Всё готово. Удачи на задании![[5360]][[42]]"
    },
    {
      "id": "fx_text/4/177",
      "ru": "Молодец, [[400]]! Отличная работа.[[5360]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/178",
      "ru": "Не вышло с заданием? Главное — работа сообща![[5360]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/179",
      "ru": "Поздравляю! Вы победили клан [[433]]![[5360]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/180",
      "ru": "Проиграли? Бывает. В следующий раз повезёт![[5360]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/181",
      "ru": "Погоди, поищу клан для обмена.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/182",
      "ru": "Новый клан! Клан [[433]] готов меняться.[[4F]][[42]]Добавлю его в список. Что хочешь обменять?[[56]][[42]]"
    },
    {
      "id": "fx_text/4/183",
      "ru": "Клан [[433]] заинтересован. Что хочешь обменять?[[56]][[42]]"
    },
    {
      "id": "fx_text/4/184",
      "ru": "Нет кланов для обмена. Попробуй позже.[[5360]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/185",
      "ru": "Обмен необратим. Сбор — [[43A]] гилей.[[4F]][[42]]Обменять\n[[4604]] [[447]]?\n[[3210]]Да/[[EOS]]Нет[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/186",
      "ru": "Сбор принят. Жди подтверждения другой стороны...[[56]][[42]]"
    },
    {
      "id": "fx_text/4/187",
      "ru": "Обмен отменён.[[5360]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/188",
      "ru": "Обмен с кланом [[433]] завершён.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/189",
      "ru": "Погоди, поищу клан для обмена.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/190",
      "ru": "Новый клан! Клан [[433]] готов меняться.[[4F]][[42]]Добавлю его в список. Кого хочешь обменять?[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/191",
      "ru": "Клан [[433]] заинтересован. Кого хочешь обменять?[[5360]][[42]]"
    },
    {
      "id": "fx_text/4/192",
      "ru": "Нет кланов для обмена. Попробуй позже.[[5360]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/193",
      "ru": "Нельзя обменять того, кого сейчас здесь нет.[[5360]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/194",
      "ru": "Обмен необратим. Сбор — [[43A]] гилей.[[4F]][[42]]Обменять\n[[448]]?\n[[3210]]Да/[[EOS]]Нет[[EOS]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/195",
      "ru": "Сбор принят. Жди подтверждения другой стороны...[[56]][[42]]"
    },
    {
      "id": "fx_text/4/196",
      "ru": "Обмен отменён.[[5360]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/197",
      "ru": "Обмен с кланом [[433]] завершён.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/198",
      "ru": "Уточню у клана [[433]]. Минуточку...[[56]][[42]]"
    },
    {
      "id": "fx_text/4/199",
      "ru": "Больше предметов не унести! Разгрузи запас![[5360]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/200",
      "ru": "Клан [[433]] больше не унесёт предметов. Прости.[[5360]][[56]][[42]]"
    },
    {
      "id": "fx_text/4/201",
      "ru": "Для игры по связи нужно сохранение.[[4F]][[42]]А? У тебя нет сохранений![[4F]][[42]]Сохрани игру и возвращайся.[[40]][[42]]"
    },
    {
      "id": "fx_text/4/202",
      "ru": "Для игры по связи нужно сохранить игру.[[4F]][[42]]Лучше сохранись прямо сейчас.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/203",
      "ru": "С возвращением. Сейчас сохраню итоги задания.[[56]][[42]]"
    },
    {
      "id": "fx_text/4/204",
      "ru": "Эй, на сбор за обмен гилей не хватает![[5360]][[56]][[42]]"
    }
  ]
}
