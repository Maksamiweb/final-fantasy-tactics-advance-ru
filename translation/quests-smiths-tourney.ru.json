{
  "batch": "P02-B008",
  "entries": [
    {
      "id": "s_text/61/10/0",
      "ru": "...[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/1",
      "ru": "Кто... ты?[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/2",
      "ru": "Кто ты? Один из уцелевших Красных крыльев?[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/3",
      "ru": "Кто ты?[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/4",
      "ru": "Кто ты? Раньше был в Красных крыльях?[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/5",
      "ru": "Кто... ты?[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/6",
      "ru": "[[102]]Кто ты, купо? Очень уж ты подозрительный![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/8",
      "ru": "Выкую тёмный клинок. Дай материалы.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/24",
      "ru": "Слышали слух о мече, да?[[4F]][[42]]Выкую... Но лишь если победите меня в бою![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/25",
      "ru": "Нам нужен твой меч... Начинаем![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/26",
      "ru": "Ради легендарного оружия![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/27",
      "ru": "Сам будешь умолять с-стать нашим кузнецом![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/28",
      "ru": "Победим тебя лишь ради твоего оружия![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/29",
      "ru": "Сам захочешь ковать для нас, вот увидишь![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/30",
      "ru": "[[103]]Не проблема, купо! Мы никому не проиграем![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/32",
      "ru": "Вы достойны. Выкую для вас сильнейший меч.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/48",
      "ru": "Заказчик, да? Читал объявление об условиях?[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/49",
      "ru": "Да. Победим ради твоего волшебного клинка![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/50",
      "ru": "Хотим добавить волшебный клинок в коллекцию![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/51",
      "ru": "Конечно. Давай уже покончим с-с этим![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/52",
      "ru": "Вызываем тебя ради волшебного клинка![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/53",
      "ru": "Нам нужен твой волшебный клинок! Вперёд![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/54",
      "ru": "[[101]]Нам нужен твой волшебный клинок, купо! Вперёд![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/56",
      "ru": "Вы победили... За это выкую клинок.[[4F]][[42]]Но знайте: он проклят. Пользуйтесь осторожно.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/73",
      "ru": "Наш шанс — поймаем их![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/74",
      "ru": "Надеюсь, они нас не сильно покусают![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/75",
      "ru": "Пора половить чудовищ![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/76",
      "ru": "Выбора нет — придётся их поймать.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/77",
      "ru": "Поймаем их! Смотритель ждёт![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/78",
      "ru": "[[103]]Видимо, придётся их поймать, купо![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/81",
      "ru": "Фух! Теперь они вернутся на ферму чудовищ.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/82",
      "ru": "Фух! Теперь они вернутся на ферму чудовищ.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/83",
      "ru": "Теперь какое-то время будут с-смирными![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/84",
      "ru": "Они вернутся на ферму. Дело закрыто.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/85",
      "ru": "Теперь смотритель будет доволен![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/86",
      "ru": "[[103]]Останутся там, где им место, купо![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/96",
      "ru": "Отдайте гилы — может, жизнь пощадим![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/97",
      "ru": "Не получишь ни гилов, ни наших жизней, вор![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/98",
      "ru": "К внезапным нападениям мы привыкли. Прости.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/99",
      "ru": "Надеешьс-ся на внезапное нападение? Зря![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/100",
      "ru": "Лишь трусы нападают исподтишка. Жалкое зрелище.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/101",
      "ru": "Ваше внезапное нападение не сработает![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/102",
      "ru": "[[103]]Наших денег никто не получит, купо! Руки прочь![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/104",
      "ru": "А-а-ах... Вы... Меня одолели...[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/105",
      "ru": "Победа! Мы прогнали разбойников![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/106",
      "ru": "Победа! Мы прогнали разбойников![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/107",
      "ru": "Это мы пощадили ваши жизни![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/108",
      "ru": "Мы не потерпим такого беззакония![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/109",
      "ru": "Одолели! Надеюсь, больше их нет...[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/110",
      "ru": "[[103]]Пусть теперь ведут себя хорошо, купо.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/121",
      "ru": "Зачем они идут в Багубу? Надо остановить![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/122",
      "ru": "Нельзя дать им разрушить Багубу! Остановим![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/123",
      "ru": "Ос-становим здесь, до Багубы![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/124",
      "ru": "Зачем в Багубу? Пока просто остановим их![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/125",
      "ru": "Что в Багубе? Сначала остановим![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/126",
      "ru": "[[103]]Остановим, пока они не разрушили Багубу, купо![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/129",
      "ru": "Пока остановили, но должен быть способ лучше...[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/130",
      "ru": "В следующий раз так не выйдет...[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/131",
      "ru": "В с-следующий раз не ос-становим... Хм.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/132",
      "ru": "Нужно разобраться, пока это не повторилось.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/133",
      "ru": "На этот раз остановили, но...[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/134",
      "ru": "[[101]]Мы их победили! Теперь мы драконоборцы, купо![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/144",
      "ru": "Пожалеете![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/145",
      "ru": "Нет, не пожалеем![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/146",
      "ru": "Лишим вас физических атак — и вы ничто![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/147",
      "ru": "Ваша с-сила или наша: что лучше?[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/148",
      "ru": "Покажем, что одной грубой силой не победить.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/149",
      "ru": "Это вы проиграете![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/150",
      "ru": "[[103]]Мы не судим о силе по внешности, купо![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/152",
      "ru": "Я ещё... Могу драться... Бух![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/153",
      "ru": "Победа! Первая за нами![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/154",
      "ru": "Матч окончен! Одна победа за нами.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/155",
      "ru": "Матч окончен! Одна победа за нами.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/156",
      "ru": "Мы выиграли первую встречу турнира.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/157",
      "ru": "Да! Отлично! Первая победа![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/158",
      "ru": "[[101]]Победа, купо! Теперь одна за нами![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/168",
      "ru": "Наша магия уложит вас на землю![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/169",
      "ru": "Пользуются магией... Лишим их этой силы![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/170",
      "ru": "Запечатаем магию — и победить будет легко.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/171",
      "ru": "Победим до того, как начнёте колдовать![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/172",
      "ru": "Хороший случай изучить чужую магию.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/173",
      "ru": "Одни маги? Просто лишим их магии![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/174",
      "ru": "[[103]]Мы лишим их магии, купо![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/176",
      "ru": "Ч-что... Пошло не так?..[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/177",
      "ru": "Победа! Следующего противника тоже одолеем?[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/178",
      "ru": "Вот волшебное слово: равновесие.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/179",
      "ru": "Вот волшебное с-слово: равновесие.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/180",
      "ru": "Победа! Следующего противника тоже одолеем.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/181",
      "ru": "Ура! Победили! Вперёд к следующему сопернику![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/182",
      "ru": "[[104]]Зря вы так полагались на магию, купо![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/192",
      "ru": "Клан [[403]]! Сразимся честно![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/193",
      "ru": "Прошлые чемпионы... Принимаем вызов![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/194",
      "ru": "Для нас честь! Начнём![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/195",
      "ru": "За чес-стный бой! Но победим мы.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/196",
      "ru": "Вы уверены в себе, но и мы не уступим.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/197",
      "ru": "Для нас честь! Но вам не проиграем![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/198",
      "ru": "[[101]]Без хитростей, купо![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/200",
      "ru": "Вы победили... Но это ещё не делает вас чемпионами![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/201",
      "ru": "Отлично! Может, и чемпионство возьмём![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/202",
      "ru": "Мы одолели прошлых чемпионов. Может, и...?[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/203",
      "ru": "Уже вижу чемпионс-ский кубок![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/204",
      "ru": "Победа над чемпионами придаёт уверенности.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/205",
      "ru": "Здорово! Вперёд за чемпионством![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/206",
      "ru": "[[103]]Ого, победили! Самих прошлых чемпионов, купо![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/216",
      "ru": "[[103]]К-купо... Мы, эм, н-не проиграем, купо![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/217",
      "ru": "Последний матч. Мы победим![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/218",
      "ru": "Последний матч! Вперёд, друзья![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/219",
      "ru": "Не ждите пощады. Начинаем![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/220",
      "ru": "Последний матч. Мы должны победить.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/221",
      "ru": "Последний матч, и мы не проиграем![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/222",
      "ru": "[[103]]Последний матч, купо! Победим![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/224",
      "ru": "[[101]]Ай! Ой! Перестарались, купо![[40]][[42]]"
    },
    {
      "id": "s_text/61/10/225",
      "ru": "Наконец-то! Значит, выходим в финал?[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/226",
      "ru": "Фух. Мы теперь финалисты, да?[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/227",
      "ru": "Опять победили. Теперь должны попасть в финал.[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/228",
      "ru": "Ещё победа. Кто встретится с нами в финале?[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/229",
      "ru": "Да! Надеюсь, теперь попадём в финал...[[40]][[42]]"
    },
    {
      "id": "s_text/61/10/230",
      "ru": "[[103]]Надеюсь, эта победа выведет нас в финал, купо![[40]][[42]]"
    }
  ]
}
