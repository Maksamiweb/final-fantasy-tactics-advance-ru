    {
      "id": "fx_text/1/8",
      "ru": "Выполнить?\n[[3211]]Да/[[EOS]]Нет[[EOS]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/1/29",
      "ru": "Сбросить настройки?\n[[3211]]Да/[[EOS]]Нет[[EOS]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/2/12",
      "ru": "Для каждой команды есть справка.[[4F]][[42]]Выберите команду и нажмите SELECT.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/0",
      "ru": "Показать очередь ходов бойцов.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/1",
      "ru": "Условия боя и сведения о задании.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/2",
      "ru": "Проверить законы и применить карты законов.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/3",
      "ru": "Изменить настройки игры.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/4",
      "ru": "Покинуть бой и отказаться от задания.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/5",
      "ru": "Сохранить текущую игру и выйти на титульный экран.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/6",
      "ru": "Проверить законы этого боя.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/7",
      "ru": "Переместить бойца. Удары со спины попадают чаще.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/8",
      "ru": "Выбрать действие бойца.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/9",
      "ru": "Ждать. Следующий ход наступит раньше.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/10",
      "ru": "Посмотреть статус бойца.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/11",
      "ru": "Атаковать оружием или голыми руками.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/12",
      "ru": "Бросить снежок. Только без камней![[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/13",
      "ru": "Призвать тотему своей расы. Тратит все очки судьи.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/14",
      "ru": "Совместная атака союзников с комбо.[[4F]][[42]]Нужно несколько бойцов. Тратит все JP.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/15",
      "ru": "Изменить снаряжение, способности, профессию.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/16",
      "ru": "Сведения о клане «[[403]]».[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/17",
      "ru": "Обмениваться и играть с другом через Game Link.[[4F]][[42]]За хорошие результаты можно получить награду![[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/18",
      "ru": "Перейти к выбранной области.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/19",
      "ru": "Сохранить или загрузить игру, изменить настройки.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/20",
      "ru": "Сохранить текущую игру.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/21",
      "ru": "Загрузить сохранение и продолжить игру.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/22",
      "ru": "Выход. Несохранённый прогресс пропадёт.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/23",
      "ru": "Освободить бойца из тюрьмы за гил.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/24",
      "ru": "Отбыть срок, чтобы снять наказание.[[4F]][[42]]Досрочно освободить бойца в этом случае нельзя.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/25",
      "ru": "Вернуться на карту мира.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/29",
      "ru": "Обмен карт законов. Курсы постоянно меняются.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/30",
      "ru": "Узнать о тенденциях на рынке карт законов.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/16/31",
      "ru": "Вернуться на карту мира.[[40]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "fx_text/1/45",
      "ru": "Повторить урок?\n[[3211]]Да/[[EOS]]Нет[[EOS]][[42]]",
      "max_width": 192,
      "max_lines": 2
    },
    {
      "id": "words:refer/22",
      "ru": "Фамфрит",
      "max_width": 64,
      "max_lines": 1
    },
