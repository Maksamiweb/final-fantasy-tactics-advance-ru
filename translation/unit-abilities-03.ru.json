{
  "batch": "P05-B007",
  "entries": [
    {
      "id": "fx_text/17/200",
      "ru": "Предмет: «Зелье+». Восстанавливает 50 HP.[[4F]][[42]]Наносит урон зомби.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/201",
      "ru": "Удар оружием о землю отбрасывает ближайших бойцов.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/202",
      "ru": "Изгоняющая зло чакра жизни уничтожает зомби.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/203",
      "ru": "Выплеск ярости: огненная атака с уроном по себе.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/204",
      "ru": "Выплеск ярости бьёт по области на расстоянии.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/205",
      "ru": "Блокирует атаку врага и контратакует.[[4F]][[42]]Не действует против А-умений.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/206",
      "ru": "Повышает физическую и магическую защиту.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/207",
      "ru": "Ослабляет атаки цели оружием.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/208",
      "ru": "Боевой клич воина бангаа наносит урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/209",
      "ru": "Управляет красными пантерами и кёрлами.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/210",
      "ru": "«Бинт» снимает обездвиживание и недееспособность.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/211",
      "ru": "Эффектный добивающий удар приносит больше JP.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/213",
      "ru": "Сила луны лечит собственные HP и снимает недуги.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/214",
      "ru": "Призывает овец, усыпляющих цель.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/215",
      "ru": "Пощёчина задерживает ход цели.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/216",
      "ru": "При тяжёлом ранении сразу получает ход.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/217",
      "ru": "При тяжёлом ранении впадает в берсерк.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/218",
      "ru": "При тяжёлом ранении получает ускорение.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/219",
      "ru": "Создаёт огненный шар, наносящий урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/220",
      "ru": "Огненное кольцо наносит урон и недееспособность.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/221",
      "ru": "Пылающий клинок наносит урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/222",
      "ru": "Обжигающее дыхание наносит урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/223",
      "ru": "Сильнейшее заклинание огня. Невероятный урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/224",
      "ru": "Мощное заклинание огня. Большой урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/225",
      "ru": "Неуловимая атака не даёт применить Р-умения.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/226",
      "ru": "Заключает цель в камень, вызывая окаменение.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/227",
      "ru": "Яростная атака. Низкая точность, огромный урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/228",
      "ru": "Призывает феникса оживить павшего союзника.[[4F]][[42]]Наносит урон зомби.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/229",
      "ru": "Предмет: «Пух феникса». Оживляет павшего бойца.[[4F]][[42]]Наносит урон зомби.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/230",
      "ru": "Крадёт оружие противника.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/231",
      "ru": "Немедленно погребает бойцов в состоянии зомби.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/232",
      "ru": "Быстро убирает оружие из руки в запас.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/233",
      "ru": "Выпускает малый метеор, наносящий урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/234",
      "ru": "Распыляет чернильный газ, вызывая слепоту.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/235",
      "ru": "Наносит урон и вызывает слепоту.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/236",
      "ru": "Сияющая энергия обращает цель в камень.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/237",
      "ru": "Закрывает глаза цели, вызывая слепоту.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/238",
      "ru": "Метель наносит урон холодом всем врагам.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/239",
      "ru": "Сильнейшее заклинание метели.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/240",
      "ru": "Создаёт ледяную глыбу, наносящую урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/241",
      "ru": "Ледяной клинок наносит урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/242",
      "ru": "Мощное заклинание метели. Бросает крупную льдину.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/243",
      "ru": "Ярость помогает учуять цель и атаковать.[[4F]][[42]]Высокая точность, малый урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/244",
      "ru": "Управляет ледяными фланами, желе и кремами.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/245",
      "ru": "Бьёт прямо по воле цели, нанося урон по MP.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/246",
      "ru": "Резкий скачок температуры наносит урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/247",
      "ru": "Останавливает обмен веществ, обращая цель в камень.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/248",
      "ru": "Извергает внутреннее пламя, нанося урон огнём.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/249",
      "ru": "Управляет парящими глазами и ариманами.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/250",
      "ru": "Белое облако повышает физическую защиту.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/251",
      "ru": "Случайно меняет сопротивление цели стихиям.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/252",
      "ru": "Сила солнца наносит урон огнём всем врагам.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/253",
      "ru": "Меняет течение времени, повышая скорость.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/254",
      "ru": "Замедляет цель. Ускоренную цель останавливает.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/255",
      "ru": "Ком земли наносит урон и обездвиживает.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/256",
      "ru": "Извергает ядовитый газ, отравляя цель.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/257",
      "ru": "Удар в голову вызывает помрачение.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/258",
      "ru": "Снижает урон от атак оружием.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/259",
      "ru": "Удар ножом тонберри оставляет 1/10 HP.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/260",
      "ru": "Бросает предмет из запаса, нанося урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/261",
      "ru": "Предмет: «Зелье». Восстанавливает 25 HP.[[4F]][[42]]Наносит урон зомби.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/262",
      "ru": "Испускает святой свет, наносящий урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/263",
      "ru": "Атака с чистым сердцем наносит святой урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/264",
      "ru": "Мяч бьёт по голове, вызывая смятение.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/265",
      "ru": "Управляет бомбами и гранатами.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/266",
      "ru": "Взмах крыльев феи лечит HP в размере своих HP.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/267",
      "ru": "Успокаивающий огонь феи восстанавливает HP.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/268",
      "ru": "Нежное, как поцелуй, касание отравляет цель.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/269",
      "ru": "Повышает физическую и магическую защиту на один бой.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/270",
      "ru": "Снижает магическую силу цели.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/271",
      "ru": "Мистический молот наносит урон по MP.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/272",
      "ru": "Наносит урон по MP.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/273",
      "ru": "Кошачья мята вызывает берсерк![[40]][[42]]"
    },
    {
      "id": "fx_text/17/274",
      "ru": "Урон по HP и MP равен потерянным HP лучника.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/275",
      "ru": "Призывает Мадина для нанесения святого урона.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/276",
      "ru": "Меняет местами HP и MP цели.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/277",
      "ru": "Отвечает на магическую атаку тем же заклинанием.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/278",
      "ru": "Повышает урон от магии.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/279",
      "ru": "Повышает физическую и магическую защиту на один ход.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/280",
      "ru": "Великая целебная магия лечит HP и оживляет павших.[[4F]][[42]]Наносит урон зомби.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/281",
      "ru": "Предугадывает обычную атаку и уклоняется.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/282",
      "ru": "Отравляет... Но на кого попадёт?[[40]][[42]]"
    },
    {
      "id": "fx_text/17/283",
      "ru": "Обнаруживает скрытое снаряжение противника.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/284",
      "ru": "Поглощает HP цели.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/285",
      "ru": "Урон зависит от числа бойцов, поверженных целью.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/286",
      "ru": "Предмет: «Глазные капли». Снимает слепоту.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/287",
      "ru": "Обрушивает огромные метеоры из космоса, нанося урон.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/288",
      "ru": "Даёт сопротивление некоторым недугам.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/289",
      "ru": "Защищает снаряжение от кражи и разрушения.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/290",
      "ru": "Дзюцу дерева. Наносит урон и обездвиживает цель.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/291",
      "ru": "Управляет мальборо и большими мальборо.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/292",
      "ru": "Ловит выпущенную в вас стрелу и стреляет в ответ.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/293",
      "ru": "Уклоняется от атак из луков и длинных луков.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/294",
      "ru": "Предмет: «Эхо-экран». Снимает немоту.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/295",
      "ru": "Жертвует собой, лечит HP союзника и снимает недуги.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/296",
      "ru": "Призывает единорога лечить HP и снимать недуги.[[4F]][[42]]Наносит урон зомби.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/297",
      "ru": "Едкая жидкость вызывает случайный недуг.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/298",
      "ru": "Управляет духами и титаниями.[[40]][[42]]"
    },
    {
      "id": "fx_text/17/299",
      "ru": "Зов тьмы усыпляет всех врагов.[[40]][[42]]"
    }
  ]
